# Python virtual environments & packages
.venv/
venv/
ENV/
env/
node_modules/

# Python cache & compiled bytecode
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.pytest_temp*/
.ruff_cache/
.cache/

# Environment files & credentials
.env
.env.*
!.env.example
*.key
*.pem

# IDE, Subagents & Operating System files
.vscode/
.idea/
.agents/teamwork/
**/.agents/teamwork_preview_*
.DS_Store
Thumbs.db
Desktop.ini
~$*
$RECYCLE.BIN/

# Standalone distribution tracking (ensures all dist/ course packages are tracked)
!dist/
!dist/**

# Archives & Temporary files (never track compressed blobs)
*.zip
*.tar.gz
*.log
*.tmp
*.bak
dist/*.zip


*.code-workspace

